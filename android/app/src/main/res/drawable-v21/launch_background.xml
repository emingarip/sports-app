<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash background. Was the Flutter template's plain white (and
  ?android:colorBackground on v21), which flashed white before the dark UI
  painted its first frame. Now follows the brand surface in light mode and
  #121212 in dark mode via values-night/colors.xml.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
