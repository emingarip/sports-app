# Supabase Configuration
# Rename this file to .env and place your actual Supabase keys below.
# DO NOT COMMIT your actual .env file to version control.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJh......your_anon_key

# Ana ekrandaki mac listesinin kaynagi (AI Sport Agent). Release
# derlemesinde BOS BIRAKILIRSA istemci http://10.0.2.2:8001 (emulator
# adresi) adresine duser ve Maclar sekmesi uretimde bos gelir.
AI_SPORT_AGENT_BASE_URL=https://sports-agent.boskale.com
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=858669470500
FIREBASE_WEB_PROJECT_ID=boskale-d00cc
REVENUECAT_APPLE_KEY=
REVENUECAT_GOOGLE_KEY=
# Android manifest'e meta-data olarak gomulur. Ads SDK gecersiz bir
# APPLICATION_ID ile baslangicta cakabilir; ADMOB_ADS_ENABLED=false
# birakilirsa manifest'e test app id yazilir ve reklamlar kapali kalir.
ADMOB_ANDROID_APP_ID=
ADMOB_ANDROID_REWARDED_ID=
ADMOB_IOS_REWARDED_ID=

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Customer Support
CRISP_WEBSITE_ID=your_crisp_website_id
SUPPORT_EMAIL=support@yourdomain.com
WHATSAPP_URL=https://wa.me/yournumber
TELEGRAM_URL=https://t.me/yourusername
INSTAGRAM_URL=https://instagram.com/yourusername
